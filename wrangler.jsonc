{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "easybplog-es",
  "compatibility_date": "2026-10-19",
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "bpes.easy-log.app",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application"
  }
}
